# A pasta env/ é versionada: .env.local, .env.hom e .env.prd têm só configuração.
# Segredo local fica em env/.env.segredo, que não vai para o git.

# Segredos e credenciais
**/credenciais/
service_account.json
**/env/.env.segredo

# Dados de execução — entrada e saída do processamento.
# Arquivo de apoio (parametrização, de-para, layout, template) NÃO fica aqui:
# fica dentro do projeto e é versionado normalmente.
dados/
entrada/
saida/

# Binários pesados
*.zip
*.exe
*.dmp
*.bak

# Python
__pycache__/
*.pyc
venv/

# IDE e editor
.idea/
.vscode/
.claude/settings.local.json
.claude/worktrees/
